# Dependencies
node_modules/

# TypeScript build output. Every workspace compiles src/ into its own lib/.
# tests/ is hand-written JavaScript, not output, and is committed.
*/lib/
*.tsbuildinfo

# Generated Xcode project. project.yml is the source of truth; running
# xcodegen produces this, and committing it means every file added shows up as
# a conflict in a 3000-line pbxproj.
ios/*.xcodeproj/
ios/build/
ios/DerivedData/

# Wrangler's local state. `wrangler dev` keeps a SQLite file per Durable Object
# under here, so a single test run leaves dozens of binary blobs that change on
# every run and mean nothing to anyone else.
.wrangler/

# Generated by `wrangler types` from wrangler.jsonc. Twelve thousand lines of
# runtime declarations that tsc needs and no human reads; regenerating it is one
# command, and committing it makes every compatibility-date bump a huge diff.
relay-worker/worker-configuration.d.ts

# Local machine state. bridle.json holds this machine's static private key and
# must never be committed; it lives in ~/.rowel, but a stray ROWEL_HOME here
# would put it in the tree.
.rowel/
bridle.json

# macOS
.DS_Store

# Signing material. A .p8 is a private key App Store Connect will not reissue
# and a .mobileprovision embeds one; neither belongs in a repo that is about to
# be public, and both are easy to `git add -A` by accident.
*.p8
AuthKey_*.p8
*.mobileprovision
*.certSigningRequest

# Working notes that are not part of the product: competitive research, the
# App Store submission dossier, the open-sourcing audit. They quote other
# people's pricing and positioning, name unreleased plans, and go stale the
# week they are written — none of which belongs in a public repository.
/GTM.md
/APPSTORE.md
/OPENSOURCE.md

# Screen recordings: regenerate with ios/RowelUITests/Recording.swift rather than store them.
marketing/shots/*.mp4
marketing/video/raw/
# Photographs of screens that failed their own check: an unexpected page,
# somebody else's session, an error. Kept out of the assets directory and out
# of the repository — they are the images most likely to hold something
# private and least likely to be looked at before a commit.
marketing/diagnostics/
# Review demo videos: hosted for App Review, too large to belong in history.
site/public/review/
